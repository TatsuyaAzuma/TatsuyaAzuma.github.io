---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props {
  work: CollectionEntry<'works'>;
}

const { work } = Astro.props;
const { title, description, thumbnail, tech } = work.data;
---

<a class="card work" href={`/works/${work.id}/`}>
  <div class="thumb">
    {thumbnail ? <img src={thumbnail} alt="" loading="lazy" /> : <span class="mono">no image</span>}
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p class="muted">{description}</p>
    <TagList tags={tech} />
  </div>
</a>

<style>
  .work {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: inherit;
  }

  .work:hover {
    text-decoration: none;
    transform: translateY(-2px);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    display: grid;
    place-items: center;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    color: var(--muted);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    padding: 16px;
  }

  h3 {
    margin: 0 0 4px;
    font-family: var(--font-mono);
    font-size: 1.05rem;
  }

  p {
    margin: 0 0 12px;
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
