---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import { formatDate } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  back: { href: string; label: string };
}

const { title, description, date, tags = [], back } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <a class="back mono" href={back.href}>← {back.label}</a>
    <header class="post-header">
      <time class="mono muted" datetime={date.toISOString()}>{formatDate(date)}</time>
      <h1 class="post-title">{title}</h1>
      {description && <p class="muted">{description}</p>}
      <TagList tags={tags} />
      <slot name="meta" />
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  article {
    max-width: 720px;
    margin: 0 auto;
  }

  .back {
    display: inline-block;
    margin-bottom: 32px;
    font-size: 0.9rem;
  }

  .post-header {
    margin-bottom: 40px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .post-header time {
    font-size: 0.85rem;
  }

  .post-title {
    font-size: clamp(1.5rem, 5vw, 2rem);
    margin: 4px 0 12px;
  }

  .post-header p {
    margin: 0 0 12px;
  }
</style>
